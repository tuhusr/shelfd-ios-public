{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Shelfd",
  "version": "0.1.0",
  "identifier": "com.shelfd.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "https://myscreenlist.com/",
    "frontendDist": "https://myscreenlist.com/"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shelfd",
        "url": "https://myscreenlist.com/",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
