function isDiscoverMemoryFresh(lastLoadedAt) {
  return lastLoadedAt && Date.now() - lastLoadedAt < DISCOVER_CACHE_TTL_MS;
}

function getDiscoverCacheKey(key) {
  return DISCOVER_CACHE_PREFIX + key;
}

function readDiscoverCacheEntry(key, allowStale = false) {
  try {
    const raw = localStorage.getItem(getDiscoverCacheKey(key));
    if (!raw) return null;
    const entry = JSON.parse(raw);
    if (!entry || !entry.savedAt || !('data' in entry)) return null;
    if (!allowStale && Date.now() - Number(entry.savedAt) > DISCOVER_CACHE_TTL_MS) return null;
    return entry.data;
  } catch (e) {
    console.warn('Discover cache read failed:', key, e);
    return null;
  }
}

function writeDiscoverCacheEntry(key, data) {
  try {
    localStorage.setItem(getDiscoverCacheKey(key), JSON.stringify({
      savedAt: Date.now(),
      data
    }));
  } catch (e) {
    console.warn('Discover cache write failed:', key, e);
  }
}

async function loadDiscoverCachedData(key, fetcher, force = false) {
  if (!force) {
    const cached = readDiscoverCacheEntry(key);
    if (cached) return cached;
  }

  try {
    const fresh = await fetcher();
    writeDiscoverCacheEntry(key, fresh);
    return fresh;
  } catch (e) {
    const stale = readDiscoverCacheEntry(key, true);
    if (stale) {
      console.warn('Using stale Discover cache after fetch failed:', key, e);
      return stale;
    }
    throw e;
  }
}

async function renderDiscoverCachedRow({ cacheKey, fetcher, render, force = false }) {
  const data = await loadDiscoverCachedData(cacheKey, fetcher, force);
  render(data);
}

async function fetchDiscoverMediaRank(section, fallbackFetcher = null) {
  const res = await fetch(`/api/rank/media?section=${encodeURIComponent(section)}&period=week`, { cache: 'no-store' });
  let payload = null;
  try { payload = await res.json(); } catch (e) { payload = null; }
  if (res.ok && payload?.ok && Array.isArray(payload.rankings)) return payload.rankings;
  if (fallbackFetcher) {
    console.warn(`Trakt-first Discover ranking failed for ${section}; using existing fallback.`, payload?.error || res.status);
    return fallbackFetcher();
  }
  throw new Error(payload?.error || `Discover ranking request failed (${res.status})`);
}

async function loadDiscover(force = false) {
  if (discoverLoading) return;
  if (discoverLoaded && !force && isDiscoverMemoryFresh(discoverLoadedAt)) return;

  discoverLoading = true;
  renderDiscoverLoading();

  try {
    syncDiscoverReleaseFilterButtons();

    const sections = [
      {
        label: 'What Your Friends Are Watching',
        gridId: 'discover-friends-watching-grid',
        run: async () => renderFriendWatchingDiscoverCards(await fetchFriendWatchingDiscoverTitles(DISCOVER_LIMIT), 'discover-friends-watching-grid', { row: true })
      },
      {
        label: 'New Releases',
        gridId: 'discover-new-releases-grid',
        run: () => renderDiscoverCachedRow({
          cacheKey: `media:trakt-new-releases:${discoverNewReleaseRange}`,
          fetcher: () => fetchDiscoverMediaRank(`new_releases_${discoverNewReleaseRange}`, () => fetchAndRankNewReleases(discoverNewReleaseRange)),
          render: items => renderRankedDiscoverCards('mixed', items, 'discover-new-releases-grid'),
          force
        })
      },
      {
        label: 'Trending Movies',
        gridId: 'discover-movies-grid',
        run: () => renderDiscoverCachedRow({
          cacheKey: 'media:trakt-trending-movies',
          fetcher: () => fetchDiscoverMediaRank('trending_movies', fetchAndRankTrendingMovies),
          render: items => renderRankedDiscoverCards('movie', items, 'discover-movies-grid'),
          force
        })
      },
      {
        label: 'Trending Shows',
        gridId: 'discover-tv-grid',
        run: () => renderDiscoverCachedRow({
          cacheKey: 'media:trakt-trending-shows',
          fetcher: () => fetchDiscoverMediaRank('trending_shows', fetchAndRankTrendingShows),
          render: items => renderRankedDiscoverCards('tv', items, 'discover-tv-grid'),
          force
        })
      },
      {
        label: "This Year's Best",
        gridId: 'discover-years-best-grid',
        run: () => renderDiscoverCachedRow({
          cacheKey: 'media:trakt-years-best',
          fetcher: () => fetchDiscoverMediaRank('years_best', fetchAndRankThisYearsBest),
          render: items => renderRankedDiscoverCards('mixed', items, 'discover-years-best-grid'),
          force
        })
      },
      {
        label: 'Releasing Soon',
        gridId: 'discover-releasing-soon-grid',
        run: () => renderDiscoverCachedRow({
          cacheKey: 'media:trakt-releasing-soon',
          fetcher: () => fetchDiscoverMediaRank('releasing_soon', fetchAndRankReleasingSoon),
          render: items => renderRankedDiscoverCards('mixed', items, 'discover-releasing-soon-grid'),
          force
        })
      },
      {
        label: 'Hidden Gems',
        gridId: 'discover-hidden-gems-grid',
        run: () => renderDiscoverCachedRow({
          cacheKey: 'media:trakt-hidden-gems',
          fetcher: () => fetchDiscoverMediaRank('hidden_gems', fetchAndRankHiddenGems),
          render: items => renderRankedDiscoverCards('mixed', items, 'discover-hidden-gems-grid'),
          force
        })
      },
      {
        label: 'Controversial / Divisive',
        gridId: 'discover-divisive-grid',
        run: () => renderDiscoverCachedRow({
          cacheKey: 'media:trakt-divisive',
          fetcher: () => fetchDiscoverMediaRank('divisive', fetchAndRankDivisiveTitles),
          render: items => renderRankedDiscoverCards('mixed', items, 'discover-divisive-grid'),
          force
        })
      },
      {
        label: 'Highly Rated Classics',
        gridId: 'discover-highly-rated-grid',
        run: () => renderDiscoverCachedRow({
          cacheKey: 'media:trakt-highly-rated-classics',
          fetcher: () => fetchDiscoverMediaRank('highly_rated_classics', fetchAndRankHighlyRated),
          render: items => renderRankedDiscoverCards('mixed', items, 'discover-highly-rated-grid'),
          force
        })
      },
      {
        label: 'Country Origin',
        gridId: 'discover-country-grid',
        run: () => loadDiscoverCountryRankings(force)
      }
    ];

    for (const section of sections) {
      try {
        await section.run();
      } catch (e) {
        console.error(`Discover row failed: ${section.label}`, e);
        renderDiscoverGridError(section.gridId, `${section.label} could not load. It will try again automatically later.`);
      }
    }

    discoverLoaded = true;
    discoverLoadedAt = Date.now();
  } catch(e) {
    console.error("Discover load failed:", e);
    renderDiscoverError("Discovery could not load. It will try again automatically later.");
  } finally {
    discoverLoading = false;
  }
}

