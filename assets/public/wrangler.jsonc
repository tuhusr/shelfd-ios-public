{
  // Required Cloudflare secret for Trakt: TRAKT_CLIENT_ID = your Trakt OAuth app Client ID.
  // Optional accepted aliases in worker.js: TRAKT_API_KEY, TRAKT_KEY, TRAKT_CLIENT_KEY.
  "name": "watchlist",
  "main": "worker.js",
  "compatibility_date": "2026-04-28",
  "durable_objects": {
    "bindings": [
      {
        "name": "VISITOR_COUNTER",
        "class_name": "VisitorCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "VisitorCounter"
      ]
    }
  ],
  "assets": {
    "directory": "assets/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "myscreenlistAi"
  },
  "routes": [
    {
      "pattern": "myscreenlist.com",
      "zone_name": "myscreenlist.com",
      "custom_domain": true
    },
    {
      "pattern": "www.myscreenlist.com",
      "zone_name": "myscreenlist.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": true
}
